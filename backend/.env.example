# --- SideKick model (required) ---
# One OpenAI key powers chat, web search, and semantic shelf memory.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=     # minimal | low | medium | high, for reasoning models
# OPENAI_TEMPERATURE=          # leave unset for GPT-5 / o-series; they only accept the default
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=
# OPENAI_BASE_URL=https://api.openai.com/v1   # point at Azure or another OpenAI-compatible gateway

# --- Web search for better deals (optional) ---
# With only OPENAI_API_KEY set, SideKick searches with OpenAI's hosted web_search tool.
# A dedicated search key below takes priority if you prefer one.
# SEARCH_PROVIDER=auto        # auto | tavily | brave | serpapi | openai | none
# OPENAI_SEARCH_MODEL=        # model for web searches, defaults to OPENAI_MODEL
# OPENAI_SEARCH_COUNTRY=CA    # two-letter country, so prices come from your market
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPAPI_API_KEY=            # uses the Google Shopping engine

# --- Shelf-history vector database (optional) ---
# OPENAI_API_KEY above already turns on semantic memory (text-embedding-3-small).
# Set EMBEDDING_PROVIDER=local to keep shelf history off the API and use the offline encoder.
# EMBEDDING_PROVIDER=auto     # auto | openai | voyage | jina | cohere | local
# VOYAGE_API_KEY=             # voyage-3-lite
# JINA_API_KEY=               # jina-embeddings-v3
# COHERE_API_KEY=             # embed-english-v3.0
# EMBEDDING_MODEL=            # override the model for the chosen provider
# VECTOR_STORE_PATH=          # defaults to backend/data/shelf-vectors.json

# --- Optional ---
# PORT=8787
# SIDEBUYSIDE_TOKEN=          # require a bearer token on the API
# FX_RATES_USD={"CAD":0.73,"EUR":1.08}   # override the offline currency table (USD per unit)
