# --- SideKick model (required) ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5-mini
# OPENROUTER_SITE_URL=http://localhost:8787
# OPENROUTER_APP_NAME=SideBuySide SideKick

# --- Web search for better deals (optional, pick one) ---
# Leave every key blank and SideKick falls back to OpenRouter's built-in web plugin.
# SEARCH_PROVIDER=auto        # auto | tavily | brave | serpapi | openrouter | none
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPAPI_API_KEY=            # uses the Google Shopping engine
# OPENROUTER_SEARCH_MODEL=    # model used for web-plugin searches, defaults to OPENROUTER_MODEL

# --- Optional ---
# PORT=8787
# SIDEBUYSIDE_TOKEN=          # require a bearer token on the API
# FX_RATES_USD={"CAD":0.73,"EUR":1.08}   # override the offline currency table (USD per unit)
